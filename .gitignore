# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local backups
/_backups_/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify generated caches, large graph dumps, and local obsidian vault (keep GRAPH_REPORT.md tracked)
graphify-out/cache/
graphify-out/obsidian/
graphify-out/graph.html
graphify-out/graph.json
graphify-out/manifest.json
graphify-out/.graphify_*

# supabase cli local state
supabase/.temp/

